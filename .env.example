# --- required in production -------------------------------------------------
SECRET_KEY=generate-a-long-random-string
BASE_URL=https://your-app.up.railway.app

# --- Railway volume ---------------------------------------------------------
# Mount a volume at /data, then set this. Without it the price cache and the
# SQLite database live on ephemeral disk and vanish on every redeploy.
DATA_DIR=/data

# --- admin ------------------------------------------------------------------
ADMIN_EMAIL=you@lgim.com
ADMIN_TOKEN=change-me-used-for-/admin?token=...

# --- email (optional) -------------------------------------------------------
# Without these, magic links and canary alerts are written to the server log.
RESEND_API_KEY=
MAIL_FROM=risk-training@yourdomain.com

# --- tuning -----------------------------------------------------------------
STALE_AFTER_HOURS=12
CHECK_RTOL=0.02
HISTORY_START=1995-01-01
