# --- required in production -------------------------------------------------
SECRET_KEY=generate-a-long-random-string
# The public address. Setup emails link here, and session cookies belong to
# this hostname.
BASE_URL=https://charliesrisk101.com

# --- Railway volume ---------------------------------------------------------
# Mount a volume at /data, then set this. Without it the price cache and the
# SQLite database live on ephemeral disk and vanish on every redeploy.
DATA_DIR=/data

# --- admin ------------------------------------------------------------------
ADMIN_EMAIL=you@lgim.com
ADMIN_TOKEN=change-me-used-for-/admin?token=...
ADMIN_NAME=Charlie

# --- email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY, setup links and canary alerts go to the server log.
# MAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Risk Model Training <hello@charliesrisk101.com>
# Replies to site emails. Defaults to ADMIN_EMAIL.
MAIL_REPLY_TO=

# --- accounts ---------------------------------------------------------------
# Anyone can sign up (they must receive the emailed link first). Set to 0 to
# close sign-up, or list domains to restrict it, e.g. lgim.com,lgimamericas.com
SIGNUP_ENABLED=1
SIGNUP_ALLOWED_DOMAINS=
# 1 = redirect the *.up.railway.app hostname to BASE_URL
REDIRECT_TO_BASE_URL=1

# --- tuning -----------------------------------------------------------------
STALE_AFTER_HOURS=12
CHECK_RTOL=0.02
HISTORY_START=1995-01-01
